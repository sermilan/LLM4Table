# 使用 Node 18 作为基础镜像
FROM node:18-alpine

# 安装必要的构建工具
RUN apk add --no-cache python3 make g++

# 设置工作目录
WORKDIR /app

# 复制前端代码
COPY frontend/ ./frontend

# 设置工作目录
WORKDIR /app/frontend

# 复制package文件
COPY frontend/package*.json ./

# 安装前端依赖
RUN npm install

# 复制剩余源代码
COPY frontend/ ./

# 构建前端应用
RUN npm run build

# 安装 serve 来提供静态文件
RUN npm install -g serve

# 暴露端口
EXPOSE 3000

# 启动命令
CMD ["serve", "-s", "dist", "-l", "3000"]